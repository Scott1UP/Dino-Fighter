{
  "name": "dino-fighter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sprites": "node --env-file=.env.local scripts/sprites.mjs",
    "sfx": "node --env-file=.env.local scripts/sfx.mjs",
    "music": "node --env-file=.env.local scripts/music.mjs",
    "voices": "node --env-file=.env.local scripts/voices.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/press-start-2p": "^5.3.0"
  }
}
